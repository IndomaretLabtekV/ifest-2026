{
  "version": "v8b-guarded-semantic-rescue",
  "base": "exact-frozen-v5",
  "proposer": "exact-frozen-v8a",
  "direction": "revert-subset-of-v8a-only",
  "v8a_threshold": 0.5817181386596663,
  "model_name": "MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7",
